{
  "name": "stundenplan-app",
  "version": "1.0.0",
  "private": true,
  "description": "Stundenplan 11BGUTI – Desktop- und Android-App",
  "author": "Freddy",
  "main": "electron/main.js",
  "dependencies": {
    "@angular/animations": "^13.2.0",
    "@angular/common": "^13.2.0",
    "@angular/compiler": "^13.2.0",
    "@angular/core": "^13.2.0",
    "@angular/forms": "^13.2.0",
    "@angular/platform-browser": "^13.2.0",
    "@angular/platform-browser-dynamic": "^13.2.0",
    "@angular/router": "^13.2.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/status-bar": "^6.0.3",
    "html2canvas": "^1.4.1",
    "rxjs": "^7.5.2",
    "tslib": "^2.3.1",
    "zone.js": "^0.11.4"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "write-version": "node scripts/write-version.js",
    "build": "npm run write-version && ng build --configuration production --base-href ./",
    "build:pages": "npm run write-version && ng build --configuration production --base-href /stundenplan-11bguti/",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish=never",
    "cap:sync": "npm run build && cap sync android",
    "dist:android": "npm run cap:sync && cd android && .\\gradlew.bat assembleRelease"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^13.2.0",
    "@angular/cli": "^13.2.0",
    "@angular/compiler-cli": "^13.2.0",
    "@capacitor/cli": "^6.2.1",
    "@types/node": "^12.11.1",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~4.6.4"
  },
  "build": {
    "appId": "de.freddy.stundenplan11bguti",
    "productName": "Stundenplan 11BGUTI",
    "copyright": "Copyright © Freddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/demo/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stundenplan 11BGUTI"
    }
  }
}
